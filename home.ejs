<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Project - Shopping Cart</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f3f5f9;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        .header {
            grid-column: 1 / -1;
            background: #252b48;
            color: white;
            padding: 22px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            font-size: 28px;
        }

        .cart-count {
            background: #ff6b6b;
            padding: 8px 13px;
            border-radius: 50%;
            font-weight: bold;
        }

        .products,
        .cart-section {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        h2 {
            margin-bottom: 20px;
            color: #252b48;
        }

        .product-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px;
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 12px;
            background: #fafafa;
        }

        .product-name {
            font-weight: bold;
            font-size: 17px;
            margin-bottom: 7px;
        }

        .product-price {
            color: #ff6b6b;
            font-weight: bold;
            font-size: 18px;
        }

        button {
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-weight: bold;
        }

        .add-to-cart-btn {
            background: #28a745;
            color: white;
            padding: 11px 18px;
        }

        .add-to-cart-btn:hover {
            background: #218838;
        }

        .cart-section {
            position: sticky;
            top: 20px;
            height: fit-content;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

        .cart-item-name {
            flex: 1;
        }

        .cart-item-price {
            color: #ff6b6b;
            font-weight: bold;
        }

        .remove-btn {
            background: #dc3545;
            color: white;
            padding: 7px 10px;
        }

        .cart-empty {
            color: #888;
            text-align: center;
            padding: 20px 0;
        }

        .cart-total {
            background: #f3f5f9;
            padding: 18px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .total-amount {
            font-size: 23px;
            font-weight: bold;
            color: #252b48;
            text-align: right;
            margin-bottom: 18px;
        }

        .pay-btn {
            width: 100%;
            background: #007bff;
            color: white;
            padding: 14px;
            font-size: 16px;
        }

        .pay-btn:hover {
            background: #0056b3;
        }

        .pay-btn:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

        @media(max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 21px;
            }

            .cart-section {
                position: static;
            }

            .product-item {
                gap: 10px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>🛒 Payment Project</h1>
            <div class="cart-count" id="cartCount">0</div>
        </div>

        <div class="products">

            <h2>Available Products</h2>

            <div id="productsList"></div>

        </div>

        <div class="cart-section">

            <h2>Shopping Cart</h2>

            <div id="cartItems" class="cart-empty">
                Your cart is empty
            </div>

            <div class="cart-total" id="cartTotalSection" style="display:none;">

                <div class="total-amount">
                    Total: ₹<span id="totalPrice">0</span>
                </div>

                <form id="paymentForm" action="/payment" method="POST">

                    <input
                        type="hidden"
                        id="cartAmount"
                        name="amount"
                        value="0"
                    >

                    <button
                        type="submit"
                        class="pay-btn"
                        id="payBtn"
                        disabled
                    >
                        💳 Proceed to Payment
                    </button>

                </form>

            </div>

        </div>

    </div>

    <script>

        // Products
        const products = [
            { id: 1, name: "JavaScript Book", price: 500 },
            { id: 2, name: "Node.js Course", price: 1500 },
            { id: 3, name: "Web Development Bundle", price: 3000 },
            { id: 4, name: "React Tutorial", price: 1200 },
            { id: 5, name: "Database Design", price: 2000 }
        ];

        // Cart
        let cart = [];

        // Display products
        function displayProducts() {

            const productsList = document.getElementById("productsList");

            productsList.innerHTML = "";

            products.forEach(product => {

                const productDiv = document.createElement("div");

                productDiv.className = "product-item";

                productDiv.innerHTML = `
                    <div>
                        <div class="product-name">${product.name}</div>
                        <div class="product-price">₹${product.price}</div>
                    </div>

                    <button
                        class="add-to-cart-btn"
                        onclick="addToCart(${product.id})"
                    >
                        Add to Cart
                    </button>
                `;

                productsList.appendChild(productDiv);

            });

        }

        // Add to cart
        function addToCart(id) {

            const product = products.find(item => item.id === id);

            if (!product) return;

            cart.push(product);

            updateCart();

        }

        // Remove from cart
        function removeFromCart(index) {

            cart.splice(index, 1);

            updateCart();

        }

        // Update cart
        function updateCart() {

            const cartItemsDiv = document.getElementById("cartItems");

            const cartCount = document.getElementById("cartCount");

            const totalPrice = document.getElementById("totalPrice");

            const cartTotalSection = document.getElementById("cartTotalSection");

            const cartAmount = document.getElementById("cartAmount");

            const payBtn = document.getElementById("payBtn");

            cartCount.textContent = cart.length;

            if (cart.length === 0) {

                cartItemsDiv.innerHTML = "Your cart is empty";

                cartItemsDiv.className = "cart-empty";

                cartTotalSection.style.display = "none";

                payBtn.disabled = true;

                cartAmount.value = 0;

                return;

            }

            let total = 0;

            cartItemsDiv.innerHTML = "";

            cartItemsDiv.className = "";

            cart.forEach((item, index) => {

                total += item.price;

                const cartItem = document.createElement("div");

                cartItem.className = "cart-item";

                cartItem.innerHTML = `
                    <div class="cart-item-name">${item.name}</div>

                    <div class="cart-item-price">₹${item.price}</div>

                    <button
                        class="remove-btn"
                        onclick="removeFromCart(${index})"
                    >
                        Remove
                    </button>
                `;

                cartItemsDiv.appendChild(cartItem);

            });

            totalPrice.textContent = total;

            cartAmount.value = total;

            cartTotalSection.style.display = "block";

            payBtn.disabled = false;

        }

        // Initialize
        displayProducts();

    </script>

</body>
</html>